{
  "name": "@tickerq/sdk",
  "version": "1.0.0",
  "description": "TickerQ Node.js SDK — outbound gRPC worker for TickerQ Hub remote execution.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"const fs=require('fs');fs.cpSync('src/protos','dist/protos',{recursive:true});\"",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tickerq",
    "scheduler",
    "background-jobs",
    "cron",
    "distributed",
    "hub",
    "sdk"
  ],
  "author": "Arcenox",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arcenox-co/TickerQ",
    "directory": "sdks/node"
  },
  "homepage": "https://tickerq.net",
  "bugs": {
    "url": "https://github.com/Arcenox-co/TickerQ/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
