<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.15.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="$(DotNetVersion)" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ExecutionLogPersistenceContract.cs" Link="Shared/ExecutionLogPersistenceContract.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared cross-provider reliability contract, compiled into this assembly so it runs
         against the Mongo provider with the same source the EF Core suite uses. -->
    <Compile Include="..\Shared\ProviderReliability\ProviderReliabilityContractTests.cs" Link="Shared\ProviderReliabilityContractTests.cs" />
    <Compile Include="..\Shared\ProviderReliability\DefinedCronMigrationContractTests.cs" Link="Shared\DefinedCronMigrationContractTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TickerQ\TickerQ.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.Utilities\TickerQ.Utilities.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.MongoDB\TickerQ.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.Dashboard\TickerQ.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.Integrations\TickerQ.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ChainDeleteBehaviorContract.cs" Link="Shared/ChainDeleteBehaviorContract.cs" />
    <Compile Include="../Shared/OverdueAcquisitionContract.cs" Link="Shared/OverdueAcquisitionContract.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/CronChainContract.cs" Link="Shared/CronChainContract.cs" /></ItemGroup>
  <ItemGroup>
    <!-- The Dashboard API suite, run against this provider's database in Docker. -->
    <Compile Include="../Shared/DashboardApi/*.cs" LinkBase="Shared/DashboardApi" />
  </ItemGroup>
</Project>
