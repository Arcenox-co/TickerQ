<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SmokeFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- EF Core follows the .NET line of the packages under test (see eng/DotNetLines.props). -->
  <PropertyGroup>
    <SmokeEfSqliteVersion Condition="'$(SmokeFramework)' == 'net8.0'">[8.0.32,9.0.0)</SmokeEfSqliteVersion>
    <SmokeEfSqliteVersion Condition="'$(SmokeFramework)' == 'net9.0'">[9.0.21,10.0.0)</SmokeEfSqliteVersion>
    <SmokeEfSqliteVersion Condition="'$(SmokeFramework)' == 'net10.0'">[10.0.13,11.0.0)</SmokeEfSqliteVersion>
    <SmokeEfSqliteVersion Condition="'$(SmokeFramework)' == 'net11.0'">[11.0.0-rc.2.26504.105,12.0.0)</SmokeEfSqliteVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TickerQ" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.Utilities" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.Dashboard" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" Version="[$(SmokeVersion)]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(SmokeEfSqliteVersion)" />
  </ItemGroup>
</Project>
