<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SmokeFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TickerQ" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.Utilities" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.Dashboard" Version="[$(SmokeVersion)]" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" Version="[$(SmokeVersion)]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.13,11.0.0)" />
  </ItemGroup>
</Project>
