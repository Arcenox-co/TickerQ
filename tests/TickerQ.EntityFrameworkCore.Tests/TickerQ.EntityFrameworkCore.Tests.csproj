<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Provider-specific tests compile only on lines where that provider has a release. -->
    <DefineConstants Condition="'$(TickerQOracleEfVersion)' != ''">$(DefineConstants);TICKERQ_TEST_ORACLE</DefineConstants>
    <DefineConstants Condition="'$(TickerQMicrotingEfVersion)' != ''">$(DefineConstants);TICKERQ_TEST_MICROTING</DefineConstants>
    <DefineConstants Condition="'$(TickerQMicrotingNamespace)' == 'Pomelo'">$(DefineConstants);TICKERQ_TEST_MICROTING_POMELO_NAMESPACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(DotNetVersion)" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(TickerQNpgsqlEfVersion)" />
    <!-- Conformance suite targets (opt-in through TICKERQ_CONFORMANCE_* connection strings). -->
    <PackageReference Include="MySql.EntityFrameworkCore" Version="$(TickerQMySqlEfVersion)" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="$(TickerQMicrotingEfVersion)" Condition="'$(TickerQMicrotingEfVersion)' != ''" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="$(TickerQOracleEfVersion)" Condition="'$(TickerQOracleEfVersion)' != ''" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="All" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole sample migration set, so tests can reuse individual migrations and verify that
         the sample's model snapshot still matches the current TickerQ model. -->
    <Compile Include="../../samples/TickerQ.Sample.Console/Migrations/*.cs" LinkBase="Shared/SampleConsoleMigrations" />
    <Compile Include="../Shared/ExecutionLogPersistenceContract.cs" Link="Shared/ExecutionLogPersistenceContract.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared cross-provider reliability contract, compiled into this assembly so it runs
         against the EF Core provider with the same source the Mongo suite uses. -->
    <Compile Include="..\Shared\ProviderReliability\ProviderReliabilityContractTests.cs" Link="Shared\ProviderReliabilityContractTests.cs" />
    <Compile Include="..\Shared\ProviderReliability\DefinedCronMigrationContractTests.cs" Link="Shared\DefinedCronMigrationContractTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TickerQ\TickerQ.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.Utilities\TickerQ.Utilities.csproj" />
    <ProjectReference Include="..\..\src\TickerQ.EntityFrameworkCore\TickerQ.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ChainDeleteBehaviorContract.cs" Link="Shared/ChainDeleteBehaviorContract.cs" />
    <Compile Include="../Shared/OverdueAcquisitionContract.cs" Link="Shared/OverdueAcquisitionContract.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/CronChainContract.cs" Link="Shared/CronChainContract.cs" /></ItemGroup>
</Project>
