<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <VersionPrefix>10.5.0</VersionPrefix>
        <VersionSuffix>beta</VersionSuffix>
        <TickerQFunctionalMinorLine>$([System.Version]::Parse('$(VersionPrefix)').Minor).x</TickerQFunctionalMinorLine>
        <DotNetVersion>[10.0.0,11.0.0)</DotNetVersion>
        <DotNetAbstractionsVersion>[10.0.0,11.0.0)</DotNetAbstractionsVersion>
        <RepositoryUrl>https://github.com/arcenox-co/TickerQ</RepositoryUrl>
        <PackageProjectUrl>https://tickerq.net/</PackageProjectUrl>
        <TickerQCommercialPackage Condition="'$(MSBuildProjectName)' == 'TickerQ' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.Utilities' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.EntityFrameworkCore' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.Caching.StackExchangeRedis' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.Dashboard' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.Instrumentation.OpenTelemetry' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.SourceGenerator' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.SDK' Or
                                             '$(MSBuildProjectName)' == 'TickerQ.RemoteExecutor'">true</TickerQCommercialPackage>
        <PackageLicenseFile Condition="'$(TickerQCommercialPackage)' == 'true'">LICENSE-COMMERCIAL.txt</PackageLicenseFile>
        <PackageLicenseExpression Condition="'$(TickerQCommercialPackage)' != 'true'">MIT OR Apache-2.0</PackageLicenseExpression>
        <Authors>Arcenox LLC</Authors>
        <Copyright>Copyright 2025-present Arcenox LLC</Copyright>
        <PackageTags>ticker;queue;cron;time;scheduler;fire-and-forget</PackageTags>
        <PackageIcon>icon.jpg</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <LangVersion>default</LangVersion>

        <!-- Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\icon.jpg" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\LICENSE-COMMERCIAL.txt"
              Pack="true"
              PackagePath=""
              Condition="'$(TickerQCommercialPackage)' == 'true'" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
